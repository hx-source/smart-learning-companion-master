# Flask app secret key
SECRET_KEY=replace-with-a-random-secret-key

# MySQL database configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=zhixueban

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b          # 生成模型（用于回答问题）
OLLAMA_EMBEDDING_MODEL=bge-m3    # 嵌入模型（用于向量检索）
OLLAMA_RERANKER_MODEL=qwen2.5:7b # 重排模型（用于重排序）
USE_OLLAMA=true
USE_RERANKER=true                # 是否启用重排

# QQ 邮箱配置
QQ_EMAIL=your-email@example.com
QQ_EMAIL_AUTH_CODE=your-email-auth-code
